generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  phone         String   @unique
  passwordHash  String
  phoneVerified Boolean  @default(false)
  role          UserRole @default(USER)

  // Personal Info
  firstName    String?
  lastName     String?
  email        String?
  nationalCode String?
  birthDate    DateTime?
  avatarUrl    String?

  // Pay Info
  cardNumber   String?
  shebaNumber  String?
  accountOwner String?

  createdAt            DateTime?                  @default(now())
  updatedAt            DateTime?                  @updatedAt
  comments             Comment[]                 @relation("UserComments")
  orders               Order[]                   @relation("UserOrders")
  enrollments          Enrollment[]              @relation("UserEnrollments")
  transactions         Transaction[]             @relation("UserTransactions")
  newsComments         NewsComment[]             @relation("UserNewsComments")
  quizAttempts         QuizAttempt[]             @relation("UserQuizAttempts")
  investmentPortfolios UserInvestmentPortfolio[] @relation("UserInvestmentPortfolios")
  images               Image[]                   @relation("UserImages")

  // CRM relations
  convertedFromLeads Lead[]              @relation("LeadConvertedUser")
  deals              Deal[]              @relation("UserDeals")
  tickets            SupportTicket[]     @relation("UserTickets")
  tagAssignments     UserTagAssignment[] @relation("UserTagAssignments")
  crmActivities      Activity[]          @relation("UserActivities")
}

// Admin Users Model - Separate from regular users for admin panel access
model AdminUser {
  id            String      @id @default(cuid())
  email         String      @unique
  phone         String?     @unique
  passwordHash  String
  name          String
  role          AdminRole   @default(ADMIN)
  status        AdminStatus @default(ACTIVE)
  lastLoginAt   DateTime?
  createdAt     DateTime?   @default(now())
  updatedAt     DateTime?   @updatedAt

  // CRM relations
  assignedLeads    Lead[]            @relation("LeadAssignee")
  ownedDeals       Deal[]            @relation("DealOwner")
  assignedTickets  SupportTicket[]   @relation("TicketAssignee")
  createdSegments  CustomerSegment[] @relation("SegmentCreator")
  crmActivities    Activity[]        @relation("ActivityAuthor")

  @@index([email])
  @@index([phone])
  @@index([status])
}

model TempUser {
  id           String   @id @default(cuid())
  phone        String   @unique
  passwordHash String
  createdAt    DateTime? @default(now())
}

model Otp {
  id        String   @id @default(cuid())
  phone     String   @unique
  code      String
  expiresAt DateTime
  createdAt DateTime? @default(now())
}

model Course {
  id              String   @id @default(cuid())
  subject         String
  price           Int
  img             String?
  rating          Float?
  description     String?  @db.LongText
  discountPercent Int?
  time            String?
  students        Int?
  videosCount     Int?
  introVideoUrl   String? // ویدیو معرفی دوره (trailer)
  likes           Int      @default(0)
  dislikes        Int      @default(0)
  hasChapters     Boolean  @default(false) // نشان‌دهنده وجود فصل‌های تنظیم شده
  createdAt       DateTime? @default(now())
  updatedAt       DateTime? @default(now())

  category   Category? @relation("CategoryCourses", fields: [categoryId], references: [id], onDelete: SetNull)
  categoryId String?  

  tags      CourseTags[] @relation("CourseTags")
  chapters  Chapter[]    @relation("CourseChapters")

  slug          String?      @unique
  level         CourseLevel?
  language      Language     @default(FA)
  prerequisites Json         @default("[]")
  learningGoals Json         @default("[]")
  instructor    String?
  status        CourseStatus @default(ACTIVE)
  published     Boolean      @default(true)
  featured      Boolean      @default(false)
  views         Int          @default(0)

  comments    Comment[]    @relation("CourseComments")
  enrollments Enrollment[] @relation("CourseEnrollments")
  orderItems  OrderItem[]  @relation("CourseOrderItems")
  quizzes     Quiz[]       @relation("CourseQuizzes")
  lessons     Lesson[]     @relation("CourseLessons")

  @@index([categoryId])
  @@index([published, featured])
}

model Chapter {
  id        String    @id @default(cuid())
  courseId  String
  course    Course    @relation("CourseChapters", fields: [courseId], references: [id], onDelete: Cascade)
  title     String    @db.VarChar(200)
  position  Int       @default(0)
  createdAt DateTime? @default(now())
  updatedAt DateTime? @updatedAt
  lessons   Lesson[]  @relation("ChapterLessons")

  @@unique([courseId, position])
  @@index([courseId])
}

model Comment {
  id String @id @default(cuid())

  // User relation (optional for testimonials from non-users)
  user   User?   @relation(fields: [userId], references: [id], name: "UserComments", onDelete: SetNull)
  userId String?

  // For testimonials without user account
  userName    String?
  userAvatar  String?
  userRole    UserRoleType?
  userCompany String?

  // Content
  text   String
  rating Int?

  // Relations
  course     Course?   @relation(fields: [courseId], references: [id], name: "CourseComments", onDelete: Cascade)
  courseId   String?  
  category   Category? @relation("CategoryComments", fields: [categoryId], references: [id], onDelete: SetNull)
  categoryId String?  

  // Engagement
  likes    Json @default("[]")
  dislikes Json @default("[]")

  // Status & Visibility
  published Boolean @default(false)
  verified  Boolean @default(false)
  featured  Boolean @default(false)

  // Analytics
  views Int @default(0)

  createdAt DateTime? @default(now())
  updatedAt DateTime? @updatedAt

  @@index([courseId, published])
  @@index([categoryId, published])
  @@index([featured])
}

model Order {
  id           String        @id @default(cuid())
  user         User?         @relation(fields: [userId], references: [id], name: "UserOrders", onDelete: SetNull)
  userId       String?      
  items        Json
  total        Int
  status       OrderStatus   @default(PENDING)
  paymentRef   String?
  createdAt    DateTime? @default(now())
  orderItems   OrderItem[]   @relation("OrderOrderItems")
  transactions Transaction[] @relation("OrderTransactions")
  deal         Deal?         @relation("OrderDeal")
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  phone     String   @unique
  createdAt DateTime? @default(now())
}

model Enrollment {
  id           String    @id @default(cuid())
  user         User      @relation(fields: [userId], references: [id], name: "UserEnrollments", onDelete: Cascade)
  userId       String   
  course       Course    @relation(fields: [courseId], references: [id], name: "CourseEnrollments", onDelete: Cascade)
  courseId     String   
  enrolledAt   DateTime? @default(now())
  progress     Int       @default(0)
  completedAt  DateTime?
  lastAccessAt DateTime?

  @@unique([userId, courseId])
}

model Transaction {
  id          String            @id @default(cuid())
  user        User?             @relation(fields: [userId], references: [id], name: "UserTransactions", onDelete: SetNull)
  userId      String?          
  order       Order?            @relation(fields: [orderId], references: [id], name: "OrderTransactions", onDelete: SetNull)
  orderId     String?          
  amount      Int
  type        TransactionType
  status      TransactionStatus
  gateway     String?
  refNumber   String?
  description String?
  createdAt   DateTime? @default(now())
}

model OrderItem {
  id      String @id @default(cuid())
  order   Order  @relation(fields: [orderId], references: [id], name: "OrderOrderItems", onDelete: Cascade)
  orderId String

  // Optional course (for course purchases)
  course   Course? @relation(fields: [courseId], references: [id], name: "CourseOrderItems", onDelete: SetNull)
  courseId String?

  // Investment portfolio data (for portfolio purchases)
  portfolioType     String? // "low", "medium", "high"
  portfolioAmount   Int? // مبلغ سرمایه‌ گذاری
  portfolioDuration Int? // مدت سرمایه‌ گذاری (ماه)

  price           Int
  discountPercent Int?
}

model Lesson {
  id          String  @id @default(cuid())
  course      Course  @relation("CourseLessons", fields: [courseId], references: [id], onDelete: Cascade)
  courseId    String 
  chapter     Chapter? @relation("ChapterLessons", fields: [chapterId], references: [id], onDelete: SetNull)
  chapterId   String?
  title       String
  description String?

  // Video relation (optional for backward compatibility)
  video   Video?  @relation("VideoLessons", fields: [videoId], references: [id], onDelete: SetNull)
  videoId String?

  // Legacy fields (for backward compatibility)
  videoUrl  String? // برای سازگاری با ویدیوهای قبلی
  thumbnail       String?
  duration        String? // legacy display duration
  durationSeconds Int?

  order     Int     @default(0) // position within course/chapter container
  published Boolean @default(true)
  views     Int     @default(0)

  createdAt DateTime? @default(now())
  updatedAt DateTime? @updatedAt

  @@index([courseId, order])
  @@index([courseId, published])
  @@index([chapterId])
  @@index([videoId])
}

enum ContentType {
  TEXT
  HTML
  MARKDOWN
}

model NewsArticle {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  excerpt     String    @db.LongText
  content     String    @db.LongText
  contentType ContentType @default(HTML) // Support for rich HTML content
  
  // Markdown and HTML content storage
  contentMarkdown  String?  @db.LongText // Raw markdown source for editing
  contentHtml      String?  @db.LongText // Rendered and sanitized HTML for display
  
  // Draft management
  draft         Boolean   @default(false)
  draftContent  String?   @db.LongText // Auto-saved version
  draftMarkdown String?   @db.LongText // Auto-saved markdown version
  
  coverImage  String?
  author      String?
  category    String
  tags        Json      @default("[]")
  published   Boolean   @default(false)
  publishedAt DateTime?
  views       Int       @default(0)

  relatedCategory Category? @relation("CategoryNews", fields: [categoryId], references: [id], onDelete: SetNull)
  categoryId      String?  

  relatedTags NewsArticleTags[] @relation("NewsTags")

  featured    Boolean @default(false)
  readingTime Int?
  likes       Int     @default(0)

  // Audit fields
  createdAt   DateTime? @default(now())
  updatedAt   DateTime? @updatedAt
  lastEditedAt DateTime? @updatedAt // Track last edit time
  comments    NewsComment[] @relation("NewsArticleComments")

  // Relation with AboutPage
  aboutPageId String?   
  aboutPage   AboutPage? @relation("AboutNews", fields: [aboutPageId], references: [id], onDelete: SetNull)

  @@index([categoryId])
  @@index([published, featured])
  @@index([publishedAt])
  @@index([draft])
}

model NewsComment {
  id        String      @id @default(cuid())
  article   NewsArticle @relation(fields: [articleId], references: [id], name: "NewsArticleComments", onDelete: Cascade)
  articleId String     
  user      User?       @relation(fields: [userId], references: [id], name: "UserNewsComments", onDelete: SetNull)
  userId    String?    
  content   String
  likes     Json        @default("[]")
  createdAt DateTime? @default(now())
  updatedAt DateTime? @updatedAt
}

// ===================== END COMMENTS =====================

model DigitalBook {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  author      String
  description String   @db.LongText
  cover       String?
  publisher   String?
  year        Int
  pages       Int?
  isbn        String?
  language    String   @default("فارسی")
  rating      Float    @default(0)
  votes       Int      @default(0)
  views       Int      @default(0)
  downloads   Int      @default(0)
  category    String
  formats     Json     @default("[]")
  bookStatus  DigitalBookStatus @default(DRAFT)
  tags        Json     @default("[]")
  readingTime String?
  isFeatured  Boolean  @default(false)
  price       Int?
  fileUrl     String?
  audioUrl    String?

  relatedTags DigitalBookTags[] @relation("BookTags")

  createdAt DateTime? @default(now())
  updatedAt DateTime? @updatedAt
}

model Category {
  id          String  @id @default(cuid())
  slug        String  @unique
  title       String
  description String?
  icon        String?
  coverImage  String?
  color       String?

  metaTitle       String?
  metaDescription String?
  metaKeywords    Json    @default("[]")

  // Hero/Landing section data
  heroTitle       String?
  heroSubtitle    String?
  heroDescription String?
  heroImage       String?
  heroCta1Text    String?
  heroCta1Link    String?
  heroCta2Text    String?
  heroCta2Link    String?

  // About section data
  aboutTitle1      String?
  aboutTitle2      String?
  aboutDescription String?
  aboutImage       String?
  aboutCta1Text    String?
  aboutCta1Link    String?
  aboutCta2Text    String?
  aboutCta2Link    String?

  // Stats/Metrics boxes (JSON array)
  // Example: [{"text": "محتوای کاربردی", "number": "1K+", "icon": "/path/to/icon.svg"}]
  statsBoxes Json? @default("[]")

  // User level options (beginner, intermediate, advanced)
  enableUserLevelSection Boolean @default(false)

  published Boolean @default(true)
  featured  Boolean @default(false)
  order     Int     @default(0)

  tags CategoryTags[] @relation("CategoryTags")

  courses  Course[]      @relation("CategoryCourses")
  content  PageContent[] @relation("CategoryContent")
  news     NewsArticle[] @relation("CategoryNews")
  faqs     FAQ[]         @relation("CategoryFAQs")
  comments Comment[]     @relation("CategoryComments")
  quizzes  Quiz[]        @relation("CategoryQuizzes")

  createdAt DateTime? @default(now())
  updatedAt DateTime? @updatedAt

  @@index([published, featured])
}

model Tag {
  id          String   @id @default(cuid())
  slug        String   @unique @default("")
  title       String
  description String?
  color       String?
  icon        String?
  published   Boolean? @default(false)

  categories CategoryTags[] @relation("CategoryTags")
  courses    CourseTags[]   @relation("CourseTags")
  news       NewsArticleTags[] @relation("NewsTags")
  books      DigitalBookTags[] @relation("BookTags")

  usageCount Int @default(0)
  clicks     Int @default(0)

  seoTitle       String?
  seoDescription String?

  createdAt DateTime? @default(now())
  updatedAt DateTime? @updatedAt

  @@index([usageCount])
}

// ===================== JUNCTION TABLES FOR MANY-TO-MANY RELATIONSHIPS =====================

model CourseTags {
  course   Course @relation("CourseTags", fields: [courseId], references: [id], onDelete: Cascade)
  courseId String
  tag      Tag    @relation("CourseTags", fields: [tagId], references: [id], onDelete: Cascade)
  tagId    String

  @@id([courseId, tagId])
  @@index([courseId])
  @@index([tagId])
}

model NewsArticleTags {
  newsArticle   NewsArticle @relation("NewsTags", fields: [newsArticleId], references: [id], onDelete: Cascade)
  newsArticleId String
  tag           Tag         @relation("NewsTags", fields: [tagId], references: [id], onDelete: Cascade)
  tagId         String

  @@id([newsArticleId, tagId])
  @@index([newsArticleId])
  @@index([tagId])
}

model DigitalBookTags {
  digitalBook   DigitalBook @relation("BookTags", fields: [digitalBookId], references: [id], onDelete: Cascade)
  digitalBookId String
  tag           Tag         @relation("BookTags", fields: [tagId], references: [id], onDelete: Cascade)
  tagId         String

  @@id([digitalBookId, tagId])
  @@index([digitalBookId])
  @@index([tagId])
}

model CategoryTags {
  category   Category @relation("CategoryTags", fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId String
  tag        Tag      @relation("CategoryTags", fields: [tagId], references: [id], onDelete: Cascade)
  tagId      String

  @@id([categoryId, tagId])
  @@index([categoryId])
  @@index([tagId])
}

// ===================== END JUNCTION TABLES =====================

model PageContent {
  id         String   @id @default(cuid())
  category   Category @relation("CategoryContent", fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId String  

  type      PageContentType
  section   String?
  title     String?
  subtitle  String?
  content   Json
  language  Language        @default(FA)
  order     Int             @default(0)
  published Boolean         @default(true)
  publishAt DateTime?
  expireAt  DateTime?

  createdAt DateTime? @default(now())
  updatedAt DateTime? @updatedAt

  @@index([categoryId, type])
  @@index([published, publishAt])
}

model FAQ {
  id          String       @id @default(cuid())
  question    String
  answer      String
  category    Category?    @relation("CategoryFAQs", fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId  String?     
  faqCategory FAQCategory?
  order       Int          @default(0)
  published   Boolean      @default(true)
  featured    Boolean      @default(false)
  views       Int          @default(0)
  helpful     Int          @default(0)
  notHelpful  Int          @default(0)
  createdAt   DateTime? @default(now())
  updatedAt   DateTime? @updatedAt

  @@index([categoryId, published])
  @@index([faqCategory])
}

model Quiz {
  id          String  @id @default(cuid())
  title       String
  description String?

  // Course relation (optional for level assessment quizzes)
  course   Course? @relation("CourseQuizzes", fields: [courseId], references: [id], onDelete: Cascade)
  courseId String?

  // Category relation (optional for category-level assessment quizzes)
  category   Category? @relation("CategoryQuizzes", fields: [categoryId], references: [id], onDelete: SetNull)
  categoryId String?  

  // Quiz settings
  timeLimit          Int? // Time limit in minutes (null = no limit)
  passingScore       Int     @default(70) // Percentage needed to pass
  maxAttempts        Int? // Maximum attempts allowed (null = unlimited)
  shuffleQuestions   Boolean @default(false)
  shuffleAnswers     Boolean @default(false)
  showResults        Boolean @default(true) // Show results after completion
  showCorrectAnswers Boolean @default(true) // Show correct answers after completion

  // Status
  published Boolean @default(false)
  order     Int     @default(0)

  // Relations
  questions QuizQuestion[] @relation("QuizQuestions")
  attempts  QuizAttempt[]  @relation("QuizAttempts")

  createdAt DateTime? @default(now())
  updatedAt DateTime? @updatedAt

  @@index([courseId, published])
  @@index([categoryId, published])
  @@index([published, order])
}

model QuizQuestion {
  id     String @id @default(cuid())
  quiz   Quiz   @relation("QuizQuestions", fields: [quizId], references: [id], onDelete: Cascade)
  quizId String

  question     String
  questionType QuestionType @default(MULTIPLE_CHOICE)

  // Options for multiple choice/checkbox questions (JSON array)
  // Example: [{"text": "گزینه 1", "isCorrect": true}, {"text": "گزینه 2", "isCorrect": false}]
  options Json @default("[]")

  // For true/false questions
  correctAnswer Boolean?

  // Explanation shown after answering
  explanation String?

  // Points awarded for correct answer
  points Int @default(1)

  order Int @default(0)

  createdAt DateTime? @default(now())
  updatedAt DateTime? @updatedAt

  @@index([quizId, order])
}

model QuizAttempt {
  id     String @id @default(cuid())
  quiz   Quiz   @relation("QuizAttempts", fields: [quizId], references: [id], onDelete: Cascade)
  quizId String

  user   User   @relation("UserQuizAttempts", fields: [userId], references: [id], onDelete: Cascade)
  userId String

  // Attempt data
  answers     Json // User's answers: [{"questionId": "...", "answer": "..." or ["...", "..."] for multiple}]
  score       Float // Score percentage (0-100)
  totalPoints Int // Total points earned
  maxPoints   Int // Maximum possible points
  passed      Boolean @default(false)
  timeSpent   Int? // Time spent in seconds

  // Status
  startedAt   DateTime? @default(now())
  completedAt DateTime?

  @@index([quizId, userId])
  @@index([userId, completedAt])
}

//
// ===================== ENUMS =====================
//
enum UserRole {
  USER
  ADMIN
}

enum CourseLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum CourseStatus {
  ACTIVE
  COMING_SOON
  ARCHIVED
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
}

enum TransactionType {
  PAYMENT
  REFUND
  WITHDRAWAL
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
}

enum PageContentType {
  LANDING
  ABOUT
  FEATURES
  FAQ
  TESTIMONIAL
  HERO
  STATS
}

enum Language {
  FA
  EN
}

enum FAQCategory {
  GENERAL
  PAYMENT
  COURSES
  TECHNICAL
}

enum UserRoleType {
  STUDENT
  PROFESSIONAL_TRADER
  INVESTOR
}

enum QuestionType {
  MULTIPLE_CHOICE // چند گزینه‌ای (یک جواب صحیح)
  MULTIPLE_SELECT // چند گزینه‌ای (چند جواب صحیح)
  TRUE_FALSE // صحیح/غلط
  SHORT_ANSWER // پاسخ کوتاه
}

// Admin Panel Enums
enum AdminRole {
  ADMIN
  MODERATOR
  VIEWER
}

enum AdminStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

// Digital Book Status Enum
enum DigitalBookStatus {
  DRAFT       // پیشنویس - هنوز منتشر نشده
  PUBLISHED   // منتشر شده
  ARCHIVED    // آرشیو شده
}

//
// ===================== LANDING PAGE MODELS =====================
//

// مدل برای مدیریت محتوای صفحه اصلی (Home Landing)
model HomeLanding {
  id String @id @default(cuid())

  // Main Hero (متن اصلی روی ویدیو)
  mainHeroTitle    String?
  mainHeroSubtitle String?
  mainHeroCta1Text String?
  mainHeroCta1Link String?

  // Hero Section
  heroTitle       String
  heroSubtitle    String?
  heroDescription String?
  heroVideoUrl    String? // لینک ویدیو پس‌زمینه
  heroCta1Text    String?
  heroCta1Link    String?

  // Overlay Text Sections (متن‌های اسکرولی روی ویدیو)
  overlayTexts Json @default("[]")

  // Stats (آمار و ارقام)
  // مثال: [{"label": "دانشجوی موفق", "value": 3000, "suffix": "+"}, ...]
  statsData Json @default("[]")

  // Why Us Section
  whyUsTitle       String?
  whyUsDescription String? @db.LongText
  // مثال: [{"label": "آموزش حرفه‌ای", "title": "...", "text": "...", "btnLabel": "...", "btnHref": "...", "imagePath": "..."}]
  whyUsItems       Json    @default("[]")

  // Newsletter/News Club Section
  newsClubTitle       String?
  newsClubDescription String? @db.LongText

  // Calculator Section
  calculatorTitle               String?
  calculatorDescription         String? @db.LongText
  calculatorRateLow             Float?  @default(0.07)
  calculatorRateMedium          Float?  @default(0.08)
  calculatorRateHigh            Float?  @default(0.11)
  calculatorPortfolioLowDesc    String?
  calculatorPortfolioMediumDesc String?
  calculatorPortfolioHighDesc   String?
  calculatorAmountSteps         Json    @default("[1000000, 10000000, 20000000, 30000000, 40000000, 50000000, 60000000, 70000000, 80000000, 90000000, 100000000, 200000000, 300000000, 500000000, 1000000000, 2000000000, 3000000000, 5000000000]")
  calculatorDurationSteps       Json    @default("[1, 3, 6, 9, 12]")
  calculatorInPersonPhone       String?
  calculatorOnlineTelegram      String?
  calculatorOnlineTelegramLink  String?

  // Meta tags
  metaTitle       String?
  metaDescription String?
  metaKeywords    Json    @default("[]")

  published Boolean @default(true)
  order     Int     @default(0)

  createdAt DateTime? @default(now())
  updatedAt DateTime? @updatedAt
}

// مدل برای مدیریت Mobile Scroller Steps
model MobileScrollerStep {
  id String @id @default(cuid())

  stepNumber    Int
  title         String
  description   String
  imageUrl      String? // تصویر داخل موبایل (مثل in-mobile-1.svg)
  coverImageUrl String? // تصویر پس‌زمینه موبایل
  gradient      String? // کلاس CSS برای gradient
  link          String? // لینک دکمه اطلاعات بیشتر

  order     Int     @default(0)
  published Boolean @default(true)

  createdAt DateTime? @default(now())
  updatedAt DateTime? @updatedAt

  @@index([published, order])
}

// مدل برای مدیریت محتوای صفحه درباره ما
model AboutPage {
  id String @id @default(cuid())

  // Hero Section
  heroTitle          String @default("")
  heroSubtitle       String?
  heroDescription    String?
  heroBadgeText      String?
  doctorIntroVideoUrl String? // ویدیو معرفی دکتر

  // Hero Stats
  // مثال: [{"label": "دانشجوی موفق", "value": 3000, "icon": "LuUsers"}]
  heroStats Json @default("[]")

  // Resume Section
  resumeTitle    String?
  resumeSubtitle String?
