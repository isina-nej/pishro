# Rich Text Editor Environment Variables

# Image Upload Configuration
NEXT_PUBLIC_UPLOAD_MAX_SIZE=5242880  # 5MB in bytes
NEXT_PUBLIC_UPLOAD_PATH=/uploads/articles

# Editor Configuration
NEXT_PUBLIC_EDITOR_AUTO_SAVE_INTERVAL=30000  # 30 seconds in milliseconds
NEXT_PUBLIC_EDITOR_MAX_LENGTH=1000000  # 1MB in characters

# Content Security Policy
NEXT_PUBLIC_CSP_ENABLED=true

# Feature Flags
NEXT_PUBLIC_EDITOR_ENABLED=true
NEXT_PUBLIC_IMAGE_UPLOAD_ENABLED=true
NEXT_PUBLIC_AUTO_SAVE_ENABLED=true


# API Endpoints