# ─────────────────────────────────────────────────────────────
# فضای ابری S3-سازگار و بکاپ دیتابیس
# مقادیر را در `.env` کپی کنید. هرگز secret واقعی را commit نکنید.
# ─────────────────────────────────────────────────────────────

STORAGE_DRIVER=s3

# مثال پارس‌پک / هر S3 سازگار — مقادیر زیر فقط نمونه هستند
S3_ENDPOINT=https://YOUR_BUCKET.example.com
S3_BUCKET_NAME=YOUR_BUCKET
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=us-east-1
S3_PUBLIC_URL=
S3_PUBLIC_ACL=true

BACKUP_PREFIX=backups/mysql
BACKUP_RETENTION_DAYS=14
BACKUP_CRON=0 23 * * *

# وقتی STORAGE_DRIVER=local است:
UPLOAD_BASE_DIR=/opt/uploade
UPLOAD_BASE_URL=/api/uploads
