# ─────────────────────────────────────────────────────────────
# فضای ابری (ParsPack Cloud Storage) و بکاپ دیتابیس
# این مقادیر را در .env پروژه بگذارید. هرگز داخل کد ننویسید.
# ─────────────────────────────────────────────────────────────

# درایور ذخیره‌سازی: local (دیسک، برای توسعه) یا s3 (فضای ابری، برای production)
STORAGE_DRIVER=s3

# ── اتصال به پارس‌پک ──────────────────────────────────────────
# نکته: در پارس‌پک خودِ هاست، نام باکت است.
# اگر End Point URL در پنل «c773651.parspack.net» باشد:
#   S3_ENDPOINT    = https://c773651.parspack.net   ← حتماً با https://
#   S3_BUCKET_NAME = c773651                        ← همان بخش اول دامنه
S3_ENDPOINT=https://c773651.parspack.net
S3_BUCKET_NAME=c773651

# کلیدها را از پنل پارس‌پک › مشخصات اتصال بردارید
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# پارس‌پک region را اعتبارسنجی نمی‌کند، ولی AWS SDK بدون آن درخواست نمی‌سازد
S3_REGION=us-east-1

# آدرس پایه دسترسی عمومی. اگر خالی بماند همان S3_ENDPOINT استفاده می‌شود.
# اگر دامنه اختصاصی به باکت وصل کردید، اینجا بگذاریدش:
# S3_PUBLIC_URL=https://cdn.pishrosarmaye.com
S3_PUBLIC_URL=

# آیا آبجکت‌های عمومی با ACL=public-read آپلود شوند؟
# اگر provider شما ACL را رد کرد، false بگذارید (آن وقت باید باکت را public کنید
# و ویدیو/بکاپ را به باکت جدا ببرید — با npm run storage:check تست کنید).
S3_PUBLIC_ACL=true

# ── بکاپ دیتابیس ─────────────────────────────────────────────
# مسیر بکاپ‌ها داخل باکت (این prefix همیشه خصوصی است)
BACKUP_PREFIX=backups/mysql

# چند روز بکاپ نگه داشته شود؟ قدیمی‌ترها خودکار حذف می‌شوند.
BACKUP_RETENTION_DAYS=14

# زمان اجرای بکاپ خودکار (فرمت cron، به وقت UTC)
# پیش‌فرض: هر شب ساعت ۲۳:۰۰ UTC ≈ ۰۲:۳۰ بامداد تهران
BACKUP_CRON=0 23 * * *

# ── دیسک محلی (فقط وقتی STORAGE_DRIVER=local است) ────────────
# باید مسیر مطلق و خارج از فولدر کد باشد (نه ./uploads و نه داخل repo).
# پیش‌فرض و مقدار پیشنهادی سرور: /opt/uploade
UPLOAD_BASE_DIR=/opt/uploade
UPLOAD_BASE_URL=/api/uploads
