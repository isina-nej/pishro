# Generated graphify artifacts
# Rebuild locally with `graphify update .` — the graph is derived from the
# source tree, so committing it only produces huge diffs on every code change.
graphify-out/

# Files setup_parspack.sh generates in the deploy directory on the server.
# rclone.conf holds the ParsPack access/secret key in plain text — it must
# never reach the repo, so keep this rule even if the script itself goes away.
rclone.conf
rclone_test_file.txt
npm-install.log
