# ─── هسته ───────────────────────────────────────────────
NODE_ENV=production
PORT=3000

# ─── دیتابیس (Prisma + mysql2) ──────────────────────────
DATABASE_URL="mysql://pishro_user:CHANGE_ME@localhost:3306/pishro"
DB_HOST=localhost
DB_PORT=3306
DB_USER=pishro_user
DB_PASSWORD=CHANGE_ME
DB_NAME=pishro

# ─── احراز هویت ─────────────────────────────────────────
NEXTAUTH_URL=https://your-domain.com
NEXTAUTH_SECRET=           # openssl rand -base64 48
ADMIN_JWT_SECRET=          # openssl rand -base64 48
ADMIN_TOKEN_EXPIRY=1d
ADMIN_REFRESH_TOKEN_EXPIRY=7d

# ─── آدرس‌های عمومی ─────────────────────────────────────
NEXT_PUBLIC_BASE_URL=https://your-domain.com
NEXT_PUBLIC_API_URL=https://your-domain.com
NEXT_PUBLIC_CMS_URL=https://your-domain.com

# ─── ذخیره‌سازی فایل ────────────────────────────────────
# local | s3
STORAGE_DRIVER=local
UPLOAD_BASE_DIR=/opt/uploade
UPLOAD_BASE_URL=/api/uploads

# اگر STORAGE_DRIVER=s3 — جزئیات بیشتر در .env.storage.example
# S3_ENDPOINT=https://YOUR_BUCKET.example.com
# S3_BUCKET_NAME=YOUR_BUCKET
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=us-east-1
# S3_PUBLIC_URL=
# S3_PUBLIC_ACL=true

# ─── ویدیو ──────────────────────────────────────────────
VIDEO_TOKEN_SECRET=        # openssl rand -base64 48
TEMP_DIR=/tmp/video-processing

# ─── پرداخت (اختیاری) ───────────────────────────────────
ZARINPAL_MERCHANT_ID=

# ─── پیامک / OTP (اختیاری؛ برای تست: SMS_SERVICE=mock) ──
SMS_SERVICE=mock
# SMS_USERNAME=
# SMS_PASSWORD=
# SMS_FROM=
# SMS_API_URL=

# ─── بکاپ ابری (اختیاری) ────────────────────────────────
# BACKUP_PREFIX=backups/mysql
# BACKUP_RETENTION_DAYS=14
# BACKUP_CRON=0 23 * * *
